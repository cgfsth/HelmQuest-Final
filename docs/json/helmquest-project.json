    { "id": "play-options", "label": "Play options", "requiresAuth": false },
    { "id": "training", "label": "Training module picker", "requiresAuth": true },
    { "id": "auth", "label": "Login", "requiresAuth": false },
    { "id": "dashboard", "label": "Student/instructor dashboard", "requiresAuth": true },
