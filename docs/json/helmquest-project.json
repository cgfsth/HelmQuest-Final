    },
    {
      "path": "helpers/normalizeBoatScale.js",
      "exports": ["normalizeBoatToScene"],
      "role": "LOA scaling and BoatPivot"
    },
    {
      "path": "helpers/helmCockpit.js",
      "exports": ["createHelmCockpit", "HELM_CAMERA_POS", "HELM_CAMERA_LOOK"],
      "role": "Helm wheel and camera constants"
    },
    {
      "path": "helpers/helmInterior.js",
      "exports": ["buildHelmInterior", "syncHelmInteriorVisibility"],
      "role": "Procedural wheelhouse"
    },
    {
      "path": "helpers/helmDeckRails.js",
      "exports": ["syncHelmDeckRailsVisibility", "tagHelmDeckRailMeshes"],
      "role": "Deck rail visibility"
    },
    {
      "path": "helpers/helmInstrumentsHud.js",
      "exports": ["initHelmInstrumentsHud", "updateHelmInstrumentsHud"],
      "role": "Radar and nav chart canvases"
    }
  ],
  "assets": [
