    { "key": "Mouse", "action": "look_yaw_pitch" },
    { "key": "Backtick", "action": "hold_exit_to_dashboard" }
  ],
  "modules": [
    {
      "path": "helpers/oceanSimulation.js",
      "exports": ["createOceanSimulation", "update", "setSunDirection"],
      "role": "Water shader plane"
    },
    {
      "path": "helpers/sceneEnvironment.js",
      "exports": ["SCENE_WATERLINE_Y", "SIMULATION_SPAWN", "updateSimulationSpawn"],
      "role": "Spawn and waterline constants"
    },
    {
