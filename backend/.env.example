# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin SDK Configuration
# Download your service account key from:
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then paste the path to the downloaded JSON file here
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Firebase Project Configuration
FIREBASE_PROJECT_ID=helmquest-565d6
FIREBASE_STORAGE_BUCKET=helmquest-565d6.firebasestorage.app
FIREBASE_DATABASE_URL=https://helmquest-565d6.firebaseio.com

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173

# API Configuration
API_PREFIX=/api/v1

# Private PDF storage (backend only; never use VITE_ for the secret key)
MATERIALS_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://hfoqctddfinmlthsqbzt.supabase.co
SUPABASE_STORAGE_BUCKET=learning-materials
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=<service_role JWT>
